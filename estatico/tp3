$cliente = $_POST['cliente'];
$origen = $_POST['origen'];
$destino = $_POST['destino'];
$tipo = $_POST['tipo'];
$equipaje = $_POST['equipaje'];

if($origen == $destino){
    $precio = 20000;
} else {
    $precio = 40000;
}

if($tipo == "plus"){
    $precio = $precio + ($precio * 0.10);
}

if($tipo == "premier"){
    $precio = $precio + ($precio * 0.20);
}

$color = "black";

if($equipaje == 50){
    $precio = $precio + 5000;
    $color = "blue";
}

if($equipaje == 20){
    $precio = $precio + 2000;
    $color = "fuchsia";
}

if($equipaje == 0){
    $color = "green";
}

echo "<h1 style='color:$color'>Valor del viaje: $precio</h1>";

