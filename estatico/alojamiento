<?php

if(isset($_POST["tipoAlo"]) && isset($_POST["dias"])){

    $tipo = $_POST["tipoAlo"];
    $dias = $_POST["dias"];

    if(!is_numeric($dias)){
        echo "Ingrese un numero valido de dias";
    }

    $dias = intval($dias);

    if($dias <= 0){
        echo "Los dias deben ser mayores a 0";
    }

    if($tipo == "hotel"){
        $precio_dia = 1200;
    }
    elseif($tipo == "posada"){
        $precio_dia = 900;
    }
    elseif($tipo == "hostel"){
        $precio_dia = 800;
    }

    $total = $precio_dia * $dias;

    if($dias > 7){
        $total = $total * 0.95;
    }

    if(isset($_POST["desayuno"])){
        $total = $total + 3000;
    }
    echo "<h2>Total a pagar: " . $total . "</h2>";

}
else{
    echo "Faltan datos";
}

